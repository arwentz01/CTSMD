APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/CTSMD
APP_BASE_PATH=/CTSMD
APP_TIMEZONE=America/New_York
SESSION_NAME=ctsmd_connect_session

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ctsmd
DB_USERNAME=andrew
DB_PASSWORD=password
DB_CHARSET=utf8mb4

# Leave STORAGE_PATH blank to use <project>/storage/private.
# On shared hosting, prefer an absolute path outside the public web root when available.
STORAGE_PATH=
STORAGE_MAX_UPLOAD_MB=20

# Email: local development should stay on log until real delivery is intentionally configured.
# Supported drivers: log, mail, smtp
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=no-reply@ctsmd.org
MAIL_FROM_NAME=CTSMD Connect
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
