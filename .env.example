APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/CTSMD
APP_BASE_PATH=/CTSMD
APP_TIMEZONE=America/New_York
SESSION_NAME=ctsmd_connect_session

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ctsmd
DB_USERNAME=andrew
DB_PASSWORD=password
DB_CHARSET=utf8mb4

# Leave STORAGE_PATH blank to use <project>/storage/private.
# On shared hosting, prefer an absolute path outside the public web root when available.
STORAGE_PATH=
STORAGE_MAX_UPLOAD_MB=20

# Email: local development should stay on log until real delivery is intentionally configured.
# Supported drivers: log, mail, smtp
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=no-reply@ctsmd.org
MAIL_FROM_NAME=CTSMD Connect
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=

# Web Push (iOS/iPadOS Home Screen web app, Android and supported desktop browsers).
# Generate once with: php bin/generate-vapid-keys.php
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY_B64=
PUSH_VAPID_SUBJECT=mailto:notifications@ctsmd.org

# Homepage presentation identity (not multi-tenant isolation).
# Empty optional values omit the logo, tagline, custom welcome text or website link.
# URLs may be absolute http(s) or root-relative; colors use six-digit hex.
ORGANIZATION_NAME=CTSMD
ORGANIZATION_LOGO=
ORGANIZATION_PRIMARY_COLOR=#8b233b
ORGANIZATION_ACCENT_COLOR=#b58a33
ORGANIZATION_TAGLINE=
ORGANIZATION_WELCOME=
ORGANIZATION_URL=

# Hosted Commerce preview: application administrators only; simulated payments/no email.
# Set to 0 to pause actions while retaining the administrator setup entry.
COMMERCE_HOSTED_SANDBOX_ENABLED=1
# Isolated local sandbox still requires its explicit opt-in.
COMMERCE_SANDBOX_ENABLED=0

# Restricted customer storefront; no ordinary visitor can simulate purchases.
COMMERCE_STOREFRONT_PREVIEW_ENABLED=1
# Independent future activation request. Simulated-only builds always fail closed.
COMMERCE_PUBLIC_SALES_ENABLED=0

# Default IANA timezone for Commerce venues without an explicit venue setting.
# Existing performance timezone snapshots never change when this value changes.
COMMERCE_VENUE_TIMEZONE=America/New_York

# Stripe TEST MODE only. Secrets belong in the hosting environment, never Git.
COMMERCE_STRIPE_TEST_ENABLED=0
COMMERCE_STRIPE_CHECKOUT_ENABLED=0
COMMERCE_STRIPE_TEST_SECRET_KEY=
COMMERCE_STRIPE_TEST_WEBHOOK_SECRET=
COMMERCE_STRIPE_ACCOUNT_ID=
COMMERCE_PUBLIC_ORIGIN=
COMMERCE_PAYMENT_WORKER_ENABLED=0

# Commerce delivery is capture-only; the general mail worker never claims these jobs.
COMMERCE_MAIL_DRIVER=capture
COMMERCE_MAIL_WORKER_ENABLED=0
COMMERCE_MAIL_ENABLED=0
COMMERCE_MAIL_APPROVED=0
COMMERCE_MAIL_TEST_RECIPIENTS=
COMMERCE_MAIL_WEBHOOK_SECRET=
COMMERCE_PUBLIC_BASE_PATH=
