{
  "expo": {
    "name": "CTSMD Connect",
    "slug": "ctsmd-connect",
    "scheme": "ctsmdconnect",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.ctsmd.connect"
    },
    "android": {
      "package": "org.ctsmd.connect",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#590816"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-font",
      "expo-video"
    ]
  }
}
