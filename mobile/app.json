{
  "expo": {
    "name": "CTSMD Connect",
    "slug": "ctsmd-connect",
    "scheme": "ctsmdconnect",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.ctsmd.connect"
    },
    "android": {
      "package": "org.ctsmd.connect"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-font"
    ]
  }
}
