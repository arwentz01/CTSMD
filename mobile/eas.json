{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "autoIncrement": true
      }
    },
    "android-play": {
      "extends": "production",
      "credentialsSource": "local",
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
