Options -Indexes
DirectoryIndex front.php index.php

<IfModule mod_dir.c>
    # MAMP may run without usable mod_rewrite. Keep this path aligned with the
    # deployed folder name, or remove it when the app is served from vhost root.
    FallbackResource /ctsmd/front.php
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep internal project directories out of direct web access when rewrite
    # support is available.
    RewriteRule ^(?:\.env|\.git|config|database|docs|src|storage|tools|views|bin|tests)(?:/|$) - [F,L]

    # Route workspace hubs through shared startup/authentication, even though
    # compatibility entrypoints exist in physical directories.
    RewriteRule ^(?:production|my-theatre)/?$ front.php [QSA,L]

    # Assets must never execute server-side scripts.
    RewriteRule ^assets/.*\.(?:php[0-9]*|phtml|phar)(?:/|$) - [F,L,NC]

    # Let real files and directories bypass the front controller.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Send application routes through the base-path-aware front controller.
    RewriteRule ^ front.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Door scanning may request the same-origin camera after a user gesture.
    # THE_REQUEST retains the original path/query after front-controller rewrites.
    Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()" "expr=%{THE_REQUEST} =~ m#\s/+(?:[^/?\s]+/)*admin/commerce/?\?(?:[^\s]*&)?tab=checkin(?:&[^\s]*)?\s#"

    <FilesMatch "\.(?:css|js|svg|webmanifest|png|jpe?g|gif|webp|ico|woff2?)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Protect configuration variants and runtime logs even without mod_rewrite.
<FilesMatch "(?i)^(?:\.env(?:\..*)?|error_log|.*\.log)$">
    Require all denied
</FilesMatch>
