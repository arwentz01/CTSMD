Options -Indexes
DirectoryIndex front.php index.php

<IfModule mod_dir.c>
    # MAMP may run without usable mod_rewrite. Keep this path aligned with the
    # deployed folder name, or remove it when the app is served from vhost root.
    FallbackResource /ctsmd/front.php
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep internal project directories out of direct web access when rewrite
    # support is available.
    RewriteRule ^(?:\.env|\.git|config|database|docs|src|storage|tools|views)(?:/|$) - [F,L]

    # The ICS importer lives beneath a physical production/ directory. Keep the
    # application-level /production destination routed through the front
    # controller while allowing deeper real importer paths to resolve normally.
    RewriteRule ^production/?$ front.php [QSA,L]

    # Let real files and directories bypass the front controller.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Send application routes through the base-path-aware front controller.
    RewriteRule ^ front.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
