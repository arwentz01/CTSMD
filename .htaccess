Options -Indexes
DirectoryIndex index.php

# Local Build 001 default when the repository is served at http://localhost/ctsmd/.
# Remove or change this when deploying at a different base path.
SetEnv APP_BASE_PATH /ctsmd

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep internal project directories out of direct web access.
    RewriteRule ^(?:\.env|\.git|config|database|docs|src|storage|tools|views)(?:/|$) - [F,L]

    # Existing files and directories, including /assets, are served directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Send application routes through the front controller.
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
