Options -Indexes
DirectoryIndex index.php

# Local Build 001 default when the repository lives at MAMP htdocs/CTSMD.
# Remove or change this when deploying at a different base path.
SetEnv APP_BASE_PATH /CTSMD

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep internal project directories out of direct web access.
    RewriteRule ^(?:\.env|\.git|config|database|docs|src|storage|tools|views)(?:/|$) - [F,L]

    # Static assets live at /assets so they can be served directly by Apache.
    # Do not route them through the front controller or depend on rewrites.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Send application routes through the front controller.
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
